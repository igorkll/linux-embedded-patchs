            "type": "kernel",
            "name": "test_6_8_12.img",
            "export": false,

            "kernel_source_url": "https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.8.12.tar.xz",
            "kernel_output_file": "bzImage",
    
            "patches": [
                "disable_vt_swithing_from_keyboard.patch",
                "disable_vt_swithing_from_wayland.patch",
                "disable_sysrq.patch",
                "disable_cad.patch",
                "disable_keyboard_echo_by_default.patch",
                "disable_tty_signals.patch",
                "disable_tty_control_flow.patch",
                "disable_printk.patch",
                "disable_reboot_and_shutdown_emerg_messages.patch",
                "make_all_emerg_messages_with_alert_loglevel.patch",
                "driver_fakeconsole.patch"
            ],
    
            "kernel_config_changes_files": [
                "kernel_config_changes.txt",
                "kernel_config_changes_x86.txt"
            ]
        },
        {
            "build-if-no-filters-or-one-filter-exists": ["7_0"],

